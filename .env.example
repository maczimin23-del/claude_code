# Local dev (SQLite file, works with no setup):
DATABASE_URL="file:./dev.db"

# Production (Postgres — Supabase, Vercel Postgres, Neon, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Also switch prisma/schema.prisma's datasource provider from "sqlite" to "postgresql".

# Admin back office password (change before deploying).
ADMIN_PASSWORD="change-me"

# Random 32+ char secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# WhatsApp number customers are routed to (digits only, with country code).
SHOP_WHATSAPP="77051234567"
